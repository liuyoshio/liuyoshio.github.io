---
/**
 * <Callout type="note" | "tip" | "warning" title="Optional title">
 *   Markdown body.
 * </Callout>
 *
 * Renders a role="note" box labelled by its title. Screen readers always hear the
 * type ("Tip: ..."), even when a custom title replaces the visible label.
 */
import { uniqueId } from '../lib/ids';

interface Props {
	type: 'note' | 'tip' | 'warning';
	title?: string;
}

const { type = 'note', title } = Astro.props;
const kind = (['note', 'tip', 'warning'] as const).includes(type) ? type : 'note';
const label = { note: 'Note', tip: 'Tip', warning: 'Warning' }[kind];
const titleId = uniqueId('callout');
---

<div class:list={['callout', `callout--${kind}`]} role="note" aria-labelledby={titleId}>
	<p class="callout-title" id={titleId}>
		{
			kind === 'note' && (
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
						d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"
					/>
				</svg>
			)
		}
		{
			kind === 'tip' && (
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
						d="M8 1.5c-2.363 0-4 1.69-4 3.75 0 .984.424 1.625.984 2.304l.214.253c.223.264.47.556.673.848.284.411.537.896.621 1.49a.75.75 0 0 1-1.484.211c-.04-.282-.163-.547-.37-.847a8.456 8.456 0 0 0-.542-.68c-.084-.1-.173-.205-.268-.32C3.201 7.75 2.5 6.766 2.5 5.25 2.5 2.31 4.863 0 8 0s5.5 2.31 5.5 5.25c0 1.516-.701 2.5-1.328 3.259-.095.115-.184.22-.268.319-.207.245-.383.453-.541.681-.208.3-.33.565-.37.847a.751.751 0 0 1-1.485-.212c.084-.593.337-1.078.621-1.489.203-.292.45-.584.673-.848.075-.088.147-.173.213-.253.561-.679.985-1.32.985-2.304 0-2.06-1.637-3.75-4-3.75ZM5.75 12h4.5a.75.75 0 0 1 0 1.5h-4.5a.75.75 0 0 1 0-1.5ZM6 15.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z"
					/>
				</svg>
			)
		}
		{
			kind === 'warning' && (
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
					<path
						fill="currentColor"
						d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"
					/>
				</svg>
			)
		}
		{
			title ? (
				<span>
					<span class="sr-only">{label}: </span>
					{title}
				</span>
			) : (
				<span>{label}</span>
			)
		}
	</p>
	<div class="callout-body">
		<slot />
	</div>
</div>

<style>
	.callout {
		--c: var(--note);
		--c-bg: var(--note-bg);
		padding: 0.875rem 1.125rem 1rem;
		border-left: 3px solid var(--c);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: var(--c-bg);
	}

	.callout--tip {
		--c: var(--tip);
		--c-bg: var(--tip-bg);
	}

	.callout--warning {
		--c: var(--warning);
		--c-bg: var(--warning-bg);
	}

	.callout-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		color: var(--c);
		font-family: var(--sans);
		font-size: 0.875rem;
		font-weight: 650;
		line-height: 1.4;
	}

	.callout-title svg {
		flex: none;
	}

	.callout-body {
		margin-top: 0.4rem;
		font-size: 0.94em;
		line-height: 1.65;
	}

	.callout-body > :global(* + *) {
		margin-top: 0.75em;
	}

	.callout-body > :global(:first-child) {
		margin-top: 0;
	}

	.callout-body > :global(:last-child) {
		margin-bottom: 0;
	}

	.callout-body :global(:not(pre) > code) {
		background: color-mix(in srgb, var(--c) 12%, transparent);
	}
</style>
