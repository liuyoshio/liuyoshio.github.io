---
import { type Post, postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
	posts: Post[];
	/** Heading level for each post title, to fit the page's outline. */
	headingLevel?: 2 | 3;
	showTags?: boolean;
}

const { posts, headingLevel = 2, showTags = true } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ol class="post-list">
	{
		posts.map((post) => (
			<li class="post-item">
				<p class="meta">
					<FormattedDate date={post.data.pubDate} />
					{post.data.draft && <span class="badge">Draft</span>}
				</p>
				<Heading class="post-item-title">
					<a href={postUrl(post)}>{post.data.title}</a>
				</Heading>
				<p class="post-item-desc">{post.data.description}</p>
				{showTags && <TagList tags={post.data.tags} class="post-item-tags" />}
			</li>
		))
	}
</ol>

<style>
	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-item {
		padding-block: 1.25rem;
	}

	.post-item + .post-item {
		border-top: 1px solid var(--border);
	}

	.post-item:first-child {
		padding-top: 0.25rem;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.post-item-title {
		margin-top: 0.25rem;
		font-size: 1.1875rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.post-item-title a {
		color: var(--text);
		text-decoration: none;
	}

	.post-item-title a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.post-item-desc {
		margin-top: 0.375rem;
		color: var(--text-muted);
		font-size: 0.9875rem;
		line-height: 1.6;
	}

	:global(.post-item-tags) {
		margin-top: 0.75rem !important;
	}
</style>
