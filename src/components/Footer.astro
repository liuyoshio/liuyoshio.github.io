---
import { GITHUB_URL, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<p>&copy; {year} {SITE_TITLE}</p>
		<ul class="links">
			<li><a href={GITHUB_URL}>GitHub</a></li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding-block: 1.75rem 2.25rem;
	}

	.links {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		color: var(--text-muted);
	}

	.links a:hover {
		color: var(--text);
	}
</style>
