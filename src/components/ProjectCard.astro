---
import type { Project } from '../data/projects';
import TagList from './TagList.astro';

interface Props {
	project: Project;
	/** URL of the project's write-up, only when that post is published. */
	postHref?: string;
	headingLevel?: 2 | 3;
}

const { project, postHref, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const primary = postHref ?? project.url ?? project.repo;
---

<article class="project">
	{project.context && <p class="context">{project.context}</p>}
	<Heading class="title">
		{primary ? <a href={primary}>{project.title}</a> : project.title}
	</Heading>
	<p class="desc">{project.description}</p>
	<TagList tags={project.tags} link={false} class="project-tags" />
	<ul class="links">
		{postHref && (
			<li>
				<a href={postHref}>Read the write-up</a>
			</li>
		)}
		{project.repo && (
			<li>
				<a href={project.repo}>Code</a>
			</li>
		)}
		{project.url && (
			<li>
				<a href={project.url}>Link</a>
			</li>
		)}
	</ul>
</article>

<style>
	.project {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.25rem 1.25rem 1.125rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		box-shadow: var(--shadow);
	}

	.context {
		margin-bottom: 0.375rem;
		color: var(--text-muted);
		font-size: 0.8125rem;
	}

	.title {
		font-size: 1.125rem;
		line-height: 1.35;
	}

	.title a {
		color: var(--text);
		text-decoration: none;
	}

	.title a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}

	.desc {
		margin-top: 0.5rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	:global(.project-tags) {
		margin-top: 0.875rem !important;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: auto 0 0;
		padding: 1rem 0 0;
		list-style: none;
		font-size: 0.9375rem;
		font-weight: 500;
	}
</style>
