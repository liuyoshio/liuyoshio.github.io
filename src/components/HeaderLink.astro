---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
const path = Astro.url.pathname;
// `/blog/` is active on the list and on every post; `/` only on the home page.
const isActive = href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<a href={href} class:list={['nav-link', className]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-block;
		padding: 0.5rem 0.625rem;
		border-radius: 6px;
		color: var(--text-muted);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}

	.nav-link:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	.nav-link[aria-current='page'] {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.45em;
	}
</style>
