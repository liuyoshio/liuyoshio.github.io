---
// Icon links for the header. To add another profile, add an <a> with an inline SVG
// (aria-hidden) and an aria-label; keep the URL in src/consts.ts.
import { GITHUB_URL } from '../consts';
---

<a class="icon-button" href={GITHUB_URL} aria-label="GitHub" title="GitHub">
	<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
		></path>
	</svg>
</a>
<a class="icon-button" href="/rss.xml" aria-label="RSS feed" title="RSS feed">
	<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M2.002 2.725a.75.75 0 0 1 .797-.699C8.79 2.42 13.58 7.21 13.974 13.201a.75.75 0 0 1-1.497.098 10.502 10.502 0 0 0-9.776-9.776.747.747 0 0 1-.7-.798ZM2.84 7.05h-.002a7.002 7.002 0 0 1 6.113 6.111.75.75 0 0 1-1.49.178 5.503 5.503 0 0 0-4.8-4.8.75.75 0 0 1 .179-1.489ZM2 13a1 1 0 1 1 2 0 1 1 0 0 1-2 0Z"
		></path>
	</svg>
</a>

<style>
	.icon-button {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 6px;
		color: var(--text-muted);
	}

	.icon-button:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}
</style>
