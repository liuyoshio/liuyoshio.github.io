---
interface Props {
	date: Date;
}

const { date } = Astro.props;
// Frontmatter dates like `2026-11-16` parse as UTC midnight; format in UTC so the
// day does not shift with the build machine's time zone.
---

<time datetime={date.toISOString().slice(0, 10)}>
	{
		date.toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
