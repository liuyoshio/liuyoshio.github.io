---
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="All posts, newest first.">
	<div class="container">
		<header class="page-header">
			<h1 class="page-title">Blog</h1>
			<p class="page-lede">
				Write-ups and walkthroughs on ML systems and LLM serving, newest first. You can also{' '}
				<a href="/tags/">browse by tag</a> or follow the <a href="/rss.xml">RSS feed</a>.
			</p>
		</header>

		{posts.length > 0 ? <PostList posts={posts} headingLevel={2} /> : <p>No posts yet.</p>}
	</div>
</BaseLayout>
