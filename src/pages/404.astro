---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
	<div class="container">
		<header class="page-header">
			<p class="section-title">404</p>
			<h1 class="page-title">Page not found</h1>
			<p class="page-lede">
				The page you were looking for does not exist or has moved. Try the <a href="/blog/"
					>list of posts</a
				> or go back <a href="/">home</a>.
			</p>
		</header>
	</div>
</BaseLayout>
